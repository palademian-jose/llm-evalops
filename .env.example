# ---- Provider selection -------------------------------------------------
# fake | openrouter | anthropic | openai. Leave empty for auto: openrouter when
# OPENROUTER_API_KEY is set, else anthropic/openai by key, else fake (with a warning).
LLM_PROVIDER=fake
# OpenRouter is the default real backend (OpenAI-compatible, model ids are OpenRouter slugs).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (HTTP-Referer / X-Title).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=llm-evalops
# Direct backends (only used when LLM_PROVIDER names them or no OpenRouter key exists).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Models (OpenRouter slugs) --------------------------------------------
# Generator model (the system under evaluation).
LLM_MODEL=anthropic/claude-sonnet-4.5
# Judge model. Must be a different model family than LLM_MODEL when both are real.
JUDGE_MODEL=openai/gpt-4.1-mini
# Cheap model for synthetic data and think-steps.
CHEAP_MODEL=anthropic/claude-haiku-4.5

# ---- Tracing --------------------------------------------------------------
# Where llmops.tracing appends JSONL spans.
TRACE_PATH=traces/spans.jsonl
# Override the bundled pricing table (src/llmops/pricing.json).
PRICING_PATH=
# Default feature/user attached to spans when not set explicitly.
TRACE_FEATURE=default
TRACE_USER_ID=anon
# Also export spans through OpenTelemetry (requires the `otel` extra).
OTEL_EXPORT=false

# ---- Caching --------------------------------------------------------------
# Optional Redis backend for the exact cache (requires the `redis` extra).
REDIS_URL=
# Cosine threshold for the semantic cache.
SEMANTIC_CACHE_THRESHOLD=0.92
# Embedding backend for the semantic cache: fake | local (hashed bag-of-words) | openai
EMBEDDING_PROVIDER=fake
# OpenAI embedding model (needs OPENAI_API_KEY; embeddings are not routed via OpenRouter).
EMBEDDING_MODEL=text-embedding-3-small

# ---- Alerts ---------------------------------------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Where `llmops check` stores the last violations and recorded outcomes.
ALERTS_DIR=alerts

# ---- Fake provider knobs --------------------------------------------------
# Lexical-overlap thresholds used by the fake judge, e.g. {"faithfulness": 0.5}
FAKE_JUDGE_THRESHOLDS=
