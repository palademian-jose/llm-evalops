# ---- Provider selection -------------------------------------------------
# fake | anthropic | openai. Defaults to fake when no key is set.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Models ---------------------------------------------------------------
# Generator model (the system under evaluation).
LLM_MODEL=claude-sonnet-4-5
# Judge model. Must be a different model family than LLM_MODEL when both are real.
JUDGE_MODEL=gpt-4.1
# Cheap model for synthetic data and think-steps.
CHEAP_MODEL=claude-haiku-4-5

# ---- Tracing --------------------------------------------------------------
# Where llmops.tracing appends JSONL spans.
TRACE_PATH=traces/spans.jsonl
# Override the bundled pricing table.
PRICING_PATH=
# Default feature/user attached to spans when not set explicitly.
TRACE_FEATURE=default
TRACE_USER_ID=anon
# Export spans through OpenTelemetry as well (requires the `otel` extra).
OTEL_EXPORT=false

# ---- Caching --------------------------------------------------------------
# Optional Redis backend for the exact cache (requires the `redis` extra).
REDIS_URL=
# Cosine threshold for the semantic cache.
SEMANTIC_CACHE_THRESHOLD=0.92
# Embedding backend for the semantic cache: fake | openai
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small

# ---- Alerts ---------------------------------------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Where `llmops check` stores the last violations and recorded outcomes.
ALERTS_DIR=alerts

# ---- Fake provider knobs --------------------------------------------------
# Lexical-overlap thresholds used by the fake judge (json: {"faithfulness": 0.5, ...}).
FAKE_JUDGE_THRESHOLDS=
